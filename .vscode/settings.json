{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.profiles.windows": {
    "GreenTokens": {
      "path": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". '${workspaceFolder}\\scripts\\terminal.ps1'"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "GreenTokens"
}
